# 복사해서 사용: cp .env.example .env

# LLM (Generator / Judge)
OPENAI_API_KEY=
LLM_MODEL=gpt-4.1-mini

# 웹서치 (적격성 검증 G2·G3, 경쟁사 비교)
TAVILY_API_KEY=

# DART OpenAPI (적격성 검증 G1 비상장 여부) - https://opendart.fss.or.kr
DART_API_KEY=

# LangSmith 트레이싱 (선택)
LANGSMITH_API_KEY=
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=skala-rag
